# ViralizaHost — variáveis de ambiente após a migração para MariaDB
# Copiar para /var/www/viralizahost/.env.local (chmod 600, dono = utilizador do PM2).
# Este ficheiro de exemplo não contém segredos; nunca versionar o .env.local real.

# ── MariaDB (lidas em runtime pelo servidor) ─────────────────────────────
MYSQL_DATABASE=viralizahost_viralizaHost
MYSQL_USER=viralizahost_userViralizaHost
MYSQL_PASSWORD=                      # a nova palavra-passe (definida só no servidor)
# Ligação: use o socket se o utilizador do cPanel for @localhost e o TCP falhar
MYSQL_SOCKET=/var/lib/mysql/mysql.sock
# ou, em alternativa ao socket:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_POOL_SIZE=10

# ── Sessões e autenticação ───────────────────────────────────────────────
AUTH_SECRET=                         # 64+ caracteres aleatórios: openssl rand -base64 48
AUTH_REQUIRE_EMAIL_CONFIRMATION=true # igual ao Supabase (confirmação de e-mail no registo)
# AUTH_EMAIL_FROM="ViralizaHost <comercial@viralizahost.com>"   # opcional

# ── Ficheiros (substitui o Supabase Storage) ─────────────────────────────
STORAGE_ROOT=/var/www/viralizahost-storage

# ── Site (NEXT_PUBLIC_* é embutido no build: definir ANTES de npm run build) ─
NEXT_PUBLIC_SITE_URL=https://viralizahost.com

# ── Já existentes (sem alteração) ────────────────────────────────────────
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=
# RESEND_WEBHOOK_SECRET=
# WHM_ENCRYPTION_KEY=
# CRON_SECRET=
# HOME_HERO_MODE= / HOME_HERO_VIDEO_SRC=   (opcionais, fallback do topo da página inicial)

# ── Só para os scripts de migração/regresso (remover depois de desativar o Supabase) ──
# SOURCE_DATABASE_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# NEW_SITE_URL=https://viralizahost.com

# ── Deixam de ser usadas pela aplicação (apagar após o período de regresso) ──
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN
