# ============================================================================
# ViralizaHost — variáveis de ambiente (exemplo; NÃO colocar valores reais aqui)
# Em produção: definir no ecosystem.config.js do PM2 ou num .env.local com
# permissões 600, fora do Git. Nenhuma destas variáveis é NEXT_PUBLIC_* salvo
# as de URL, por isso não chegam ao navegador.
# ============================================================================

# ── Base de dados MariaDB (cPanel) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
# Opcional: socket Unix (tem prioridade sobre host/porta). No cPanel costuma ser
# /var/lib/mysql/mysql.sock — confirmar com: mysqladmin variables | grep socket
DB_SOCKET=
DB_NAME=viralizahost_viralizaHost
DB_USER=viralizahost_app
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=10
DB_SSL=false

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://viralizahost.com
NEXT_PUBLIC_APP_URL=https://viralizahost.com

# ── Autenticação ─────────────────────────────────────────────────────────────
# Exigir confirmação de e-mail no registo (true por omissão, como no Supabase)
AUTH_EMAIL_CONFIRMATION=true
AUTH_SESSION_DAYS=30

# ── Armazenamento de ficheiros (substitui o Supabase Storage) ────────────────
# Pasta fora de public/ e fora da pasta da release (sobrevive a deploys)
STORAGE_DIR=/home/viralizahost/viralizahost-storage
# Segredo HMAC para URLs assinados (gerar com: openssl rand -hex 32)
STORAGE_SIGNING_SECRET=gere-um-valor-aleatorio-com-64-caracteres
# Opcional: origem dos URLs públicos (por omissão NEXT_PUBLIC_SITE_URL)
STORAGE_PUBLIC_BASE_URL=

# ── E-mail (facturas + recuperação de senha + confirmação de conta) ─────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=comercial@viralizahost.com
RESEND_FROM_NAME=ViralizaHost
RESEND_WEBHOOK_SECRET=

# ── IA (Agente) ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── WHM / tarefas agendadas ──────────────────────────────────────────────────
WHM_ENCRYPTION_KEY=
CRON_SECRET=

# ── Topo da página inicial (reserva se a base não responder) ─────────────────
HOME_HERO_MODE=carousel
HOME_HERO_VIDEO_SRC=

# ── Só para o script de migração (scripts/mariadb/migrate-data.mjs) ─────────
# Ligação directa ao PostgreSQL do Supabase (Settings → Database → Connection string,
# modo "Session"). Necessária para ler auth.users (hashes) e storage.objects.
SOURCE_DATABASE_URL=
# Para descarregar ficheiros do Storage (service role key; só no servidor)
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
